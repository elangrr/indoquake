{
  "name": "indoquake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @indoquake/web",
    "dev:worker": "npm run dev -w @indoquake/worker",
    "build": "npm run build -w @indoquake/web",
    "test": "npm run test --workspaces --if-present && vitest run --dir scripts && vitest run --config scripts/vitest.web-api.config.mjs",
    "lint": "eslint packages apps/worker scripts && npm run lint -w @indoquake/web",
    "typecheck": "npm exec -w @indoquake/web -- next typegen && npm run typecheck --workspaces --if-present && tsc --noEmit -p scripts",
    "db:generate": "npm run db:generate -w @indoquake/database",
    "db:migrate": "npm run db:migrate -w @indoquake/database",
    "db:check": "npm run db:check -w @indoquake/database",
    "env:sync": "node scripts/sync-env.mjs",
    "build:coastline": "node scripts/build-coastline.mjs",
    "build:provinces": "node scripts/build-provinces.mjs",
    "test:int": "node scripts/test-int.mjs",
    "test:e2e": "npm run e2e -w @indoquake/e2e",
    "gate": "bash scripts/gate.sh"
  },
  "engines": {
    "node": ">=20.9"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "^24.13.5",
    "eslint": "^9.39.5",
    "fast-check": "4.10.2",
    "testcontainers": "12.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "yaml": "2.9.1"
  }
}
