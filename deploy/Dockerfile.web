# Web (Next.js standalone). Build context: repository root.
#   docker build -f deploy/Dockerfile.web -t indoquake-web .
FROM node:24.22.1-alpine AS build
WORKDIR /repo
ENV NEXT_TELEMETRY_DISABLED=1 NEXT_BUILD_CPUS=4
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages ./packages
RUN npm ci --no-audit --no-fund --ignore-scripts
COPY . .
ARG NEXT_PUBLIC_CARTO_API_KEY=""
ARG NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
ENV NEXT_PUBLIC_CARTO_API_KEY=$NEXT_PUBLIC_CARTO_API_KEY \
    NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=$NEXT_PUBLIC_TELEGRAM_BOT_USERNAME
RUN npm run build -w @indoquake/web && mkdir -p apps/web/public

FROM node:24.22.1-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build --chown=node:node /repo/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=node:node /repo/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
