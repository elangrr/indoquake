# Production .env for deploy/compose.prod.yml. Generate the two secrets on the host, never commit
# the result (see HOST_STEPS.draft.md): openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=
LOG_LEVEL=info

# Worker: BMKG polling per feed in seconds (floor 5); BMKG allows 60 requests per minute per IP.
BMKG_POLL_AUTOGEMPA_SECONDS=10
BMKG_POLL_GEMPATERKINI_SECONDS=20
BMKG_POLL_GEMPADIRASAKAN_SECONDS=30
# 0 keeps every quake forever.
RETENTION_DAYS=0
EVENT_LOG_RETENTION_HOURS=72
# Region backfill at worker start (re-assigns rows below the current assignment version, silent).
# off = skip it (stop switch); the worker logs province_backfill_skipped.
REGION_BACKFILL=on

# Web: live stream caps per web process.
SSE_MAX_CONNECTIONS=500
SSE_MAX_PER_IP=6

# Optional, empty = off.
NEXT_PUBLIC_CARTO_API_KEY=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
