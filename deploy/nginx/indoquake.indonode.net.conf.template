# Indoquake vhost (new file only; no other site is touched). Copy to sites-available as
# indoquake.indonode.net.conf, enable, `nginx -t`, reload, then run certbot --nginx for TLS.
# The web container listens on 127.0.0.1:3410 only.

limit_req_zone $binary_remote_addr zone=indoquake_req:10m rate=20r/s;

server {
    listen 80;
    listen [::]:80;
    server_name indoquake.indonode.net;

    client_max_body_size 64k;

    # Live stream: no buffering, no caching, no gzip, long-lived HTTP/1.1 connection.
    location /api/v1/stream {
        proxy_pass http://127.0.0.1:3410;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        limit_req zone=indoquake_req burst=40 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3410;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
