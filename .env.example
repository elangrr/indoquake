# Salin ke .env lalu isi password (JANGAN commit file .env).
# Setelah diisi, jalankan: npm run env:sync  (menyalin ke apps/web/.env.local agar dibaca Next.js)
# Dev memakai Postgres (PostGIS) dan Redis lokal di Docker; perintahnya ada di docs/DEPLOY.md.
# Produksi memakai deploy/env.example (compose.prod.yml), bukan file ini.
DATABASE_URL=postgres://indoquake:GANTI_PASSWORD@127.0.0.1:5432/indoquake
REDIS_URL=redis://127.0.0.1:6379
LOG_LEVEL=info

# Interval polling per feed BMKG (detik, minimal 5). Batas BMKG 60 permintaan/menit per IP.
BMKG_POLL_AUTOGEMPA_SECONDS=10
BMKG_POLL_GEMPATERKINI_SECONDS=20
BMKG_POLL_GEMPADIRASAKAN_SECONDS=30
# Retensi gempa (hari). 0 = simpan selamanya (D06).
RETENTION_DAYS=0
# event_log (replay live stream) dipangkas tiap jam setelah sekian jam.
EVENT_LOG_RETENTION_HOURS=72

# Batas live stream per proses web.
SSE_MAX_CONNECTIONS=500
SSE_MAX_PER_IP=6

# CARTO Basemaps API key (gratis s/d 5 juta tile/bulan). Daftar: https://carto.com/basemaps/apikey
# Dipakai di sisi browser (prefix NEXT_PUBLIC_), jadi jangan pakai key yang sensitif.
NEXT_PUBLIC_CARTO_API_KEY=

# Opsional: token bot Telegram (dari @BotFather) untuk notifikasi langganan Telegram.
# Kosongkan bila tidak memakai kanal Telegram.
TELEGRAM_BOT_TOKEN=

# Opsional: username bot Telegram TANPA @ (mis. IndoquakeBot). Dipakai untuk
# menampilkan tautan "Buka bot" bagi pengunjung (agar tak perlu Chat ID manual).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
