# Salin ke .env lalu isi password (JANGAN commit file .env).
# Setelah diisi, jalankan: npm run env:sync  (menyalin ke apps/web/.env.local agar dibaca Next.js)
# Pastikan SSH tunnel aktif: localhost:55432 -> Postgres VPS, localhost:56379 -> Redis VPS.
# Lihat docs/VPS_SETUP.md untuk perintah tunnel.
DATABASE_URL=postgres://indoquake:GANTI_PASSWORD@127.0.0.1:55432/indoquake_dev
REDIS_URL=redis://:GANTI_PASSWORD@127.0.0.1:56379

# Interval polling feed BMKG (detik). 3 feed x 1 permintaan per siklus; batas BMKG 60/menit.
BMKG_POLL_INTERVAL_SECONDS=30
# Retensi riwayat gempa (hari). Kejadian lebih lama dari ini dihapus otomatis.
RETENTION_DAYS=3
LOG_LEVEL=info

# CARTO Basemaps API key (gratis s/d 5 juta tile/bulan). Daftar: https://carto.com/basemaps/apikey
# Dipakai di sisi browser (prefix NEXT_PUBLIC_), jadi jangan pakai key yang sensitif.
NEXT_PUBLIC_CARTO_API_KEY=GANTI_DENGAN_API_KEY_CARTO

# Opsional: token bot Telegram (dari @BotFather) untuk notifikasi langganan Telegram.
# Kosongkan bila tidak memakai kanal Telegram.
TELEGRAM_BOT_TOKEN=

# Opsional: username bot Telegram TANPA @ (mis. IndoquakeBot). Dipakai untuk
# menampilkan tautan "Buka bot" bagi pengunjung (agar tak perlu Chat ID manual).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
